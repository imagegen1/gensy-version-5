### Financial Data Integration
```typescript
// Financial data service integrating with pricing sheet
class FinancialDataService {
  // Get true cost based on pricing sheet
  static getTrueCost(model: string, isVideo: boolean = false): number {
    const pricingSheet = {
      'imagen-4-fast': { trueCost: 1.77 },
      'flux-dev': { trueCost: 2.21 },
      // ... other models from pricing sheet
      'veo-3': { trueCost: 660.39 }
    }
    return pricingSheet[model]?.trueCost || 0
  }
  
  // Calculate revenue based on credit pricing
  static calculateRevenue(credits: number): number {
    return credits * 0.02 // ₹0.02 per credit
  }
  
  // Calculate profit margin
  static calculateMargin(model: string, credits: number, isVideo: boolean = false): number {
    const trueCost = this.getTrueCost(model, isVideo)
    const revenue = this.calculateRevenue(credits)
    return ((revenue - trueCost) / revenue) * 100
  }
  
  // Get generations per plan
  static getGenerationsPerPlan(planPrice: number, model: string): number {
    const pricingSheet = {
      'imagen-4-fast': { creditsPerGeneration: 197 },
      'flux-dev': { creditsPerGeneration: 246 },
      // ... other models
      'veo-3': { creditsPerGeneration: 73377 }
    }
    const creditsPerGeneration = pricingSheet[model]?.creditsPerGeneration || 0
    const totalCredits = planPrice / 0.02
    return Math.floor(totalCredits / creditsPerGeneration)
  }
  
  // Calculate credit usage
  static calculateCreditUsage(userId: string): Promise<CreditUsage> {
    return supabase
      .from('credit_transactions')
      .select('*')
      .eq('user_id', userId)
      .then(result => {
        const transactions = result.data || []
        const totalPurchased = transactions
          .filter(t => t.type === 'purchase')
          .reduce((sum, t) => sum + t.amount, 0)
        const totalUsed = transactions
          .filter(t => t.type === 'deduction')
          .reduce((sum, t => sum + t.amount, 0)
        return {
          totalPurchased,
          totalUsed,
          remaining: totalPurchased - totalUsed
        }
      })
  }
}
```

### Security Event Integration
```typescript
// Security event tracking
class SecurityEventService {
  static async logSecurityEvent(
    userId: string | null,
    eventType: SecurityEventType,
    details: Record<string, any>
  ): Promise<void> {
    await supabase
      .from('security_events')
      .insert({
        user_id: userId,
        event_type: eventType,
        ip_address: details.ip,
        user_agent: details.userAgent,
        timestamp: new Date().toISOString(),
        metadata: details
      })
    
    // Check for suspicious patterns
    this.checkForThreats(userId, eventType, details)
  }
  
  private static async checkForThreats(
    userId: string | null,
    eventType: SecurityEventType,
    details: Record<string, any>
  ): Promise<void> {
    // Check for multiple failed logins
    if (eventType === 'login_failed') {
      const recentFailures = await this.getRecentEvents(
        userId,
        'login_failed',
        5 * 60 * 1000 // 5 minutes
      )
      
      if (recentFailures.length >= 5) {
        await this.triggerSecurityAlert(
          'MULTIPLE_LOGIN_FAILURES',
          `User ${userId} has ${recentFailures.length} failed login attempts`,
          { userId, failures: recentFailures.length },
          'high'
        )
      }
    }
    
    // Check for content policy violations
    if (eventType === 'content_policy_violation') {
      await this.triggerSecurityAlert(
        'CONTENT_POLICY_VIOLATION',
        `Content policy violation by user ${userId}`,
        details,
        'medium'
      )
    }
  }
  
  static async triggerSecurityAlert(
    alertType: string,
    message: string,
    metadata: Record<string, any>,
    severity: 'low' | 'medium' | 'high'
  ): Promise<void> {
    // Create alert in database
    const { data, error } = await supabase
      .from('security_alerts')
      .insert({
        alert_type: alertType,
        message,
        metadata,
        severity,
        status: 'active',
        created_at: new Date().toISOString()
      })
      .select()
      .single()
    
    if (error) throw new Error(`Failed to create security alert: ${error.message}`)
    
    // Send notification based on severity
    if (severity === 'high') {
      await this.sendSlackAlert(data)
    }
    
    if (severity === 'medium') {
      await this.sendEmailAlert(data)
    }
  }
}
```

## 🔒 Security Considerations

### Access Control
- **Role-based access control** with four tiers:
  1. **Viewer**: Read-only access to monitoring data
  2. **Operator**: Can perform operational tasks (queue management, restart services)
  3. **Finance Admin**: Access to financial data and discount management
  4. **Super Admin**: Full access including financial and security controls

- **Just-in-time permissions** for sensitive operations (discount creation, credit adjustments)
- **Audit logging** for all administrative actions
- **Session isolation** to prevent accidental production changes
- **Financial data segregation** to protect sensitive financial information
- **Strict RBAC implementation** using Supabase RLS policies

### Data Protection
- **Masking of sensitive financial data** in logs and displays
- **No caching of admin panel content** in browser
- **Automatic logout** after 10 minutes of inactivity
- **Encrypted communication** for all admin traffic
- **Financial data encryption** at rest
- **Masking of sensitive data** in logs and displays

### Secure Development Practices
- **Separate admin API routes** with enhanced security
- **Input validation** for all admin operations
- **Rate limiting** for admin endpoints
- **Change verification** for critical operations
- **Secure session settings** with rolling sessions
- **Concurrent session limits**
- **Session hijacking detection**
- **Session cleanup mechanisms**

